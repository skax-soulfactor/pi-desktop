{
  "name": "@pi-desktop/mate",
  "productName": "Pi Desktop Mate",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "묻기 전에 먼저 살펴보고 제안하는 능동형 코딩 동료 (기능은 @pi-desktop/mate-kit, 실행은 @pi-desktop/mate-runner)",
  "author": "soulfactorx",
  "homepage": "https://github.com/soulfactorx/pi-desktop",
  "license": "MIT",
  "main": "out/main/index.js",
  "scripts": {
    "predev": "npm run build -w @pi-desktop/mate-runner",
    "dev": "npm run start:all -w @pi-desktop/desktop",
    "dev:mock": "npm run dev:mock:all -w @pi-desktop/desktop",
    "build": "npm run build -w @pi-desktop/mate-runner && electron-vite build",
    "build:web": "npm run build -w @pi-desktop/mate-runner && node scripts/build-web.mjs",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "test": "vitest run",
    "dist": "node ../../scripts/third-party-notices.mjs && npm run build && electron-builder --config electron-builder.yml --publish never",
    "render-icon": "electron scripts/render-icon.mjs"
  },
  "devDependencies": {
    "@pi-desktop/agent-kit": "*",
    "@pi-desktop/host-deploy": "*",
    "@pi-desktop/host-protocol": "*",
    "@pi-desktop/mate-kit": "*",
    "@pi-desktop/mate-runner": "*",
    "@pi-desktop/pi-isolation": "*",
    "@pi-desktop/pi-resources": "*",
    "@pi-desktop/tunables-ui": "*",
    "@pi-desktop/web-shell": "*",
    "@pi-desktop/window-state": "*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "44.9.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
