{
  "name": "@pi-desktop/agent-kit",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Pi Desktop Agent의 기능 묶음. Pi 패키지(확장·스킬)라서 터미널 pi에도 설치할 수 있다",
  "license": "MIT",
  "keywords": [
    "pi-package"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./constants": "./src/constants.ts",
    "./approval": "./src/approval.ts",
    "./tasks": "./extensions/tasks/store.ts",
    "./task-types": "./extensions/tasks/types.ts",
    "./schedules": "./extensions/schedule/store.ts",
    "./schedule-plan": "./extensions/schedule/plan.ts",
    "./memory": "./extensions/memory/store.ts",
    "./permissions": "./extensions/permissions/store.ts",
    "./usage": "./src/usage.ts",
    "./usage-types": "./src/usage-types.ts"
  },
  "pi": {
    "extensions": [
      "./extensions/agent-core/index.ts",
      "./extensions/permissions/index.ts",
      "./extensions/loop-guard/index.ts",
      "./extensions/local-model/index.ts",
      "./extensions/ask-user/index.ts",
      "./extensions/web/index.ts",
      "./extensions/memory/index.ts",
      "./extensions/documents/index.ts",
      "./extensions/tasks/index.ts",
      "./extensions/schedule/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.3.0"
  }
}
